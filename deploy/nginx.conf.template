# 个人工作台 —— nginx 反向代理
# __DOMAIN__ 由 deploy/setup.sh 替换成真实域名
#
# 注意：这里只监听 80。HTTPS 由 certbot 自己改写这个文件（见 部署指南.md）。

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # 上传导入包时别被 1M 的默认值挡住
    client_max_body_size 32m;

    # 让应用知道「外面来的是 https」和「外面访问的是哪个域名」。
    # X-Forwarded-Host 是给 middleware 拼登录跳转地址用的：应用只监听 127.0.0.1，
    # 靠自己永远猜不到真实域名，漏了这个头用户会被跳到 http://localhost:3200/login。
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Host $host;

    # Next 的静态资源带哈希，可以放心长缓存
    location /_next/static/ {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:__PORT__;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
