[Unit]
Description=个人工作台（Next.js）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=__PORT__
Environment=WORKBENCH_SHA=__SHA__
# 数据目录显式指定，换工作目录也不会丢库
Environment=WORKBENCH_DATA_DIR=__APP_DIR__/data
# 首启不要灌那 7 条示例任务，线上从空开始
Environment=WORKBENCH_SEED=0
# cookie 的 Secure 优先看 nginx 传来的 x-forwarded-proto；
# setup.sh 会在「证书申请成功」后把这里改成 1，「没上 https」时改成 0，
# 避免 http 下浏览器把 cookie 丢掉导致登不进去。
Environment=WB_SECURE_COOKIE=0
ExecStart=__NODE_BIN__ __APP_DIR__/node_modules/next/dist/bin/next start -p __PORT__ -H 127.0.0.1
Restart=always
RestartSec=3
# 内存吃紧时优先杀应用，别去动 sshd / nginx —— 否则一 OOM 就连不上机器。
OOMScoreAdjust=200
Nice=5
StandardOutput=journal
StandardError=journal

# 只允许写自己的目录，别的一概不给
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
