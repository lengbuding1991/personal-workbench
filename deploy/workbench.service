[Unit]
Description=个人工作台（Next.js）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=__PORT__
Environment=WORKBENCH_SHA=__SHA__
# 数据目录显式指定，换工作目录也不会丢库
Environment=WORKBENCH_DATA_DIR=__APP_DIR__/data
# 首启不要灌那 7 条示例任务，线上从空开始
Environment=WORKBENCH_SEED=0
# 线上是 https，cookie 必须带 Secure；http 调试时把它删掉
Environment=WB_SECURE_COOKIE=1
ExecStart=__NODE_BIN__ __APP_DIR__/node_modules/next/dist/bin/next start -p __PORT__ -H 127.0.0.1
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# 只允许写自己的目录，别的一概不给
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
